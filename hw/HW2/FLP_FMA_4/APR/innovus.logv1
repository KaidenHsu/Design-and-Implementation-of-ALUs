[10/20 18:00:41    633s] @file 117:
[10/20 18:00:41    633s] @file 118: # Add stripes inside either the core or die bounding box.
[10/20 18:00:41    633s] @file 119: proc createRegionStripe { direction layer nets offset width spacing pitch region} {
[10/20 18:00:41    633s] 
[10/20 18:00:41    633s]     # Select the target area from the requested physical region.
[10/20 18:00:41    633s]     if { $region == "Core" } {
[10/20 18:00:41    633s]         set area [get_db designs .core_bbox]
[10/20 18:00:41    633s]     } elseif {$region == "Die" } {
[10/20 18:00:41    633s]         set area [get_db designs .bbox]
[10/20 18:00:41    633s]     } else {
[10/20 18:00:41    633s]         puts "unknow region"
[10/20 18:00:41    633s]         return;
[10/20 18:00:41    633s]     }
[10/20 18:00:41    633s] 
[10/20 18:00:41    633s]     # Select adjacent layers, clamping the result to the available layer range.
[10/20 18:00:41    633s]     set LayerNum [get_db layer:$layer .route_index] 
[10/20 18:00:41    633s]     set botLayerNum [expr $LayerNum - 1]
[10/20 18:00:41    633s]     if {$botLayerNum < 1 } {
[10/20 18:00:41    633s]         set botLayerNum 1
[10/20 18:00:41    633s]     }
[10/20 18:00:41    633s]     set topLayerNum [expr $LayerNum + 1]
[10/20 18:00:41    633s]     if {$topLayerNum > 11} {
[10/20 18:00:41    633s]         set topLayerNum 11
[10/20 18:00:41    633s]     } 
[10/20 18:00:41    633s]     set botLayer    [get_db layer:$botLayerNum .name]
[10/20 18:00:41    633s]     set topLayer    [get_db layer:$topLayerNum .name]
[10/20 18:00:41    633s] 
[10/20 18:00:41    633s]     # Convert the short direction name into the value expected by add_stripes.
[10/20 18:00:41    633s]     set direction [expr {$direction eq "H" ? "horizontal" : "vertical" }]
[10/20 18:00:41    633s]    
[10/20 18:00:41    633s]     # Configure stripe creation for the selected area.
[10/20 18:00:41    633s]     set_db add_stripes_ignore_block_check false
[10/20 18:00:41    633s]     set_db add_stripes_break_at none
[10/20 18:00:41    633s]     set_db add_stripes_route_over_rows_only false
[10/20 18:00:41    633s]     set_db add_stripes_rows_without_stripes_only false
