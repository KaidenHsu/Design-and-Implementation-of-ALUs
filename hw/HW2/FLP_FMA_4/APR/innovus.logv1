[10/20 18:00:41    633s]     set_db add_stripes_partial_set_through_domain false
[10/20 18:00:41    633s]     set_db add_stripes_ignore_non_default_domains false
[10/20 18:00:41    633s]     set_db add_stripes_trim_antenna_back_to_shape none
[10/20 18:00:41    633s]     set_db add_stripes_spacing_type edge_to_edge
[10/20 18:00:41    633s]     set_db add_stripes_spacing_from_block 0
[10/20 18:00:41    633s]     set_db add_stripes_stripe_min_length stripe_width
[10/20 18:00:41    633s]     set_db add_stripes_stacked_via_top_layer M5
[10/20 18:00:41    633s]     set_db add_stripes_stacked_via_bottom_layer M1
[10/20 18:00:41    633s]     set_db add_stripes_via_using_exact_crossover_size false
[10/20 18:00:41    633s]     set_db add_stripes_split_vias false
[10/20 18:00:41    633s]     set_db add_stripes_orthogonal_only true
[10/20 18:00:41    633s]     set_db add_stripes_allow_jog { block_ring }
[10/20 18:00:41    633s]     set_db add_stripes_skip_via_on_pin {  Block standardcell }
[10/20 18:00:41    633s]     set_db add_stripes_skip_via_on_wire_shape {  noshape Stripe  }
[10/20 18:00:41    633s]     add_stripes -nets $nets -layer $layer -direction $direction -width $width -spacing $spacing -set_to_set_distance $pitch  -start_from bottom -start_offset $offset -switch_layer_over_obs false -pad_core_ring_top_layer_limit $RTopLayer -pad_core_ring_bottom_layer_limit $RBotLayer -block_ring_top_layer_limit $BTopLayer -block_ring_bottom_layer_limit $BBotLayer -use_wire_group 0 -snap_wire_center_to_grid none -user_class "manual_rail"
[10/20 18:00:41    633s] }
[10/20 18:00:41    633s] @file 35:
[10/20 18:00:41    633s] @file 36: # Add a regular power stripe and automatically use the adjacent layers for vias.
[10/20 18:00:41    633s] @file 37: proc createPowerStripe { direction layer nets offset width spacing pitch snap} {
[10/20 18:00:41    633s] 
[10/20 18:00:41    633s]     # Find the neighboring routing layers for stacked-via generation.
[10/20 18:00:41    633s]     set LayerNum [get_db layer:$layer .route_index] 
[10/20 18:00:41    633s]     if {$LayerNum > 1} {
[10/20 18:00:41    633s]         set botLayerNum [expr $LayerNum - 1]
[10/20 18:00:41    633s]     }
[10/20 18:00:41    633s]     if {$LayerNum < 11} {
[10/20 18:00:41    633s]         set topLayerNum [expr $LayerNum + 1]
[10/20 18:00:41    633s]     }
[10/20 18:00:41    633s]     set botLayer    [get_db layer:$botLayerNum .name]
[10/20 18:00:41    633s]     set topLayer    [get_db layer:$topLayerNum .name]
[10/20 18:00:41    633s] 
[10/20 18:00:41    633s]     # Convert the short direction name into the value expected by add_stripes.
[10/20 18:00:41    633s]     set direction [expr {$direction eq "H" ? "horizontal" : "vertical" }]
[10/20 18:00:41    633s]    
[10/20 18:00:41    633s]     # Configure stripe creation, via generation, obstacle handling, and snapping.
[10/20 18:00:41    633s]     set_db add_stripes_ignore_block_check false
[10/20 18:00:41    633s]     set_db add_stripes_break_at none
[10/20 18:00:41    633s]     set_db add_stripes_route_over_rows_only false
[10/20 18:00:41    633s]     set_db add_stripes_rows_without_stripes_only false
[10/20 18:00:41    633s]     set_db add_stripes_extend_to_closest_target ring
[10/20 18:00:41    633s]     set_db add_stripes_stop_at_last_wire_for_area false
[10/20 18:00:41    633s]     set_db add_stripes_partial_set_through_domain false
[10/20 18:00:41    633s]     set_db add_stripes_ignore_non_default_domains false
[10/20 18:00:41    633s]     set_db add_stripes_trim_antenna_back_to_shape none
[10/20 18:00:41    633s]     set_db add_stripes_spacing_type edge_to_edge
[10/20 18:00:41    633s]     set_db add_stripes_spacing_from_block 0
[10/20 18:00:41    633s]     set_db add_stripes_stripe_min_length stripe_width
[10/20 18:00:41    633s]     set_db add_stripes_stacked_via_top_layer $topLayer
[10/20 18:00:41    633s]     set_db add_stripes_stacked_via_bottom_layer $botLayer
[10/20 18:00:41    633s]     set_db add_stripes_via_using_exact_crossover_size false
[10/20 18:00:41    633s]     set_db add_stripes_split_vias false
[10/20 18:00:41    633s]     set_db add_stripes_orthogonal_only true
[10/20 18:00:41    633s]     set_db add_stripes_allow_jog { block_ring }
[10/20 18:00:41    633s]     set_db add_stripes_skip_via_on_pin {  standardcell }
[10/20 18:00:41    633s]     set_db add_stripes_skip_via_on_wire_shape {  noshape   }
[10/20 18:00:41    633s]     add_stripes -nets $nets -layer $layer -direction $direction -width $width -spacing $spacing -set_to_set_distance $pitch -start_from bottom -start_offset $offset -switch_layer_over_obs false -max_same_layer_jog_length 2 -pad_core_ring_top_layer_limit $topLayer -pad_core_ring_bottom_layer_limit $botLayer -block_ring_top_layer_limit $topLayer -block_ring_bottom_layer_limit $botLayer -use_wire_group 0 -snap_wire_center_to_grid $snap 
[10/20 18:00:41    633s] }
