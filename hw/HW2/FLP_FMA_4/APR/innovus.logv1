[10/20 23:44:03   4604s] #@ Begin verbose source (pre): source lab_script/fix_manual_via12.tcl
[10/20 23:44:03   4604s] @file 1: #set_db check_drc_limit 100000
[10/20 23:44:03   4604s] @file 2: #check_drc
[10/20 23:44:03   4604s] @file 3:
[10/20 23:44:03   4604s] @file 4: set errors [get_db current_design .markers -if {.subtype == Cut_Spacing}]
[10/20 23:44:03   4604s] @file 5:
[10/20 23:44:03   4604s] @file 6: foreach marker $errors {
[10/20 23:44:03   4604s]    set mbox [get_db $marker .bbox]
[10/20 23:44:03   4604s]    foreach via [get_obj_in_area -areas $mbox -obj_type special_via] {
[10/20 23:44:03   4604s]       if { [get_db $via .user_class] == "VIA12_Manual" } {
[10/20 23:44:03   4604s]          delete_obj $via
[10/20 23:44:03   4604s]       }
[10/20 23:44:03   4604s]    }
[10/20 23:44:03   4604s] }
[10/20 23:44:03   4604s] #@ End verbose source: lab_script/fix_manual_via12.tcl
