[10/20 18:00:41    633s] @file 170:
[10/20 18:00:41    633s] @file 171:
[10/20 18:00:41    633s] @file 172: # Create a core power ring around the standard-cell core.
[10/20 18:00:41    633s] @file 173: # hlayer/vlayer select the horizontal and vertical ring layers.
[10/20 18:00:41    633s] @file 174: proc createPowerRing { nets hlayer vlayer width spacing offset wire_group } {
[10/20 18:00:41    633s]     # Determine the lower and upper layers needed for stacked vias.
[10/20 18:00:41    633s]     set vLayerNum [get_db layer:$vlayer .route_index] 
[10/20 18:00:41    633s]     set hLayerNum [get_db layer:$hlayer .route_index] 
[10/20 18:00:41    633s]     if { $vLayerNum > $hLayerNum } {
[10/20 18:00:41    633s]         set botLayerNum $hLayerNum
[10/20 18:00:41    633s]         set topLayerNum $vLayerNum
[10/20 18:00:41    633s]     } else {
[10/20 18:00:41    633s]         set botLayerNum $vLayerNum
[10/20 18:00:41    633s]         set topLayerNum $hLayerNum
[10/20 18:00:41    633s]     }
[10/20 18:00:41    633s] 
[10/20 18:00:41    633s]     if {$botLayerNum >= 1} {
