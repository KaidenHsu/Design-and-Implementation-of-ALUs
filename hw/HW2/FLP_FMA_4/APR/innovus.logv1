[10/20 18:00:41    633s] @file 2: # Add a power stripe with explicit ring-layer limits.
[10/20 18:00:41    633s] @file 3: # direction: H/V; layer: stripe layer; nets: power/ground nets.
[10/20 18:00:41    633s] @file 4: # offset, width, spacing, and pitch control stripe placement and geometry.
[10/20 18:00:41    633s] @file 5: # R*/B*Layer limit routing against pad/core and block rings.
[10/20 18:00:41    633s] @file 6: proc createPowerStripeRail { direction layer nets offset width spacing pitch RTopLayer RBotLayer BTopLayer BBotLayer} {
[10/20 18:00:41    633s]     variable curRegionBKG
[10/20 18:00:41    633s] 
[10/20 18:00:41    633s]     # Convert the short direction name into the value expected by add_stripes.
[10/20 18:00:41    633s]     set direction [expr {$direction eq "H" ? "horizontal" : "vertical" }]
[10/20 18:00:41    633s]    
[10/20 18:00:41    633s]     # Configure stripe behavior for rails that connect to existing rings.
[10/20 18:00:41    633s]     set_db add_stripes_ignore_block_check false
[10/20 18:00:41    633s]     set_db add_stripes_break_at none
[10/20 18:00:41    633s]     set_db add_stripes_route_over_rows_only false
[10/20 18:00:41    633s]     set_db add_stripes_rows_without_stripes_only false
[10/20 18:00:41    633s]     set_db add_stripes_extend_to_closest_target ring
