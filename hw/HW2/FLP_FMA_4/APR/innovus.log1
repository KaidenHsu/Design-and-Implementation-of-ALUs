@innovus 130> source lab_script/fix_manual_via12.tcl

#@ Begin verbose source (pre): source lab_script/fix_manual_via12.tcl
@file 1: #set_db check_drc_limit 100000
@file 2: #check_drc
@file 3:
@file 4: set errors [get_db current_design .markers -if {.subtype == Cut_Spacing}]
@file 5:
@file 6: foreach marker $errors {
   set mbox [get_db $marker .bbox]
   foreach via [get_obj_in_area -areas $mbox -obj_type special_via] {
      if { [get_db $via .user_class] == "VIA12_Manual" } {
         delete_obj $via
      }
   }
}
#@ End verbose source: lab_script/fix_manual_via12.tcl
